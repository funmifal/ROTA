# Backend Port
PORT=5000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rota_dev?schema=public"

# JWT Secret for Session Management
JWT_SECRET="super-secret-jwt-key-rota-mvp-dev-change-in-production"

# Redis Connection (Optional for initial auth / session checks; hosted free tier like Upstash or local)
REDIS_URL="redis://localhost:6379"

# Bcrypt Adaptive Cost Factor (Must be >= 10; default: 12)
BCRYPT_SALT_ROUNDS=12

# Application Base URL (for verification links)
APP_URL="http://localhost:5000"

# Nodemailer SMTP Configuration for Transactional Emails
EMAIL_FROM="Rota <noreply@rotaapp.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Email Verification Expiry (in minutes, default: 15)
EMAIL_VERIFICATION_EXPIRY_MINUTES=15

# Flutterwave Payment Gateway Configuration (Requirement 5 & Subscription Checkout)
# Obtain your API keys from Flutterwave Dashboard -> Settings -> API Keys (https://dashboard.flutterwave.com/)
FLW_PUBLIC_KEY="FLWPUBK_TEST-your-flutterwave-public-key-X"
FLW_SECRET_KEY="FLWSECK_TEST-your-flutterwave-secret-key-X"
FLW_ENCRYPTION_KEY="FLWSECK_TEST_encryption_key"
FLW_SECRET_HASH="rota_flw_webhook_secret_hash_dev"

