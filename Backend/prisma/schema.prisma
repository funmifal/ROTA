generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum SwapStatus {
  PENDING
  ACCEPTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  emailVerifiedAt     DateTime?
  tokenVersion        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  memberships         Membership[]
  sentInvitations     Invitation[]         @relation("InvitedByUser")
  auditLogs           AuditLog[]
  settings            UserSettings?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  notificationsEnabled Boolean  @default(true)
  emailAlerts          Boolean  @default(true)
  shiftReminders       Boolean  @default(true)
  timeFormat24h        Boolean  @default(false)
  autoAcceptSwaps      Boolean  @default(false)
  theme                String   @default("system")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model EmailVerified {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  token     String?  @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("EmailVerified")
}

model Business {
  id          String        @id @default(cuid())
  name        String
  industry    String?
  country     String?
  timezone    String        @default("Africa/Lagos") // IANA timezone identifier
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  departments  Department[]
  locations    Location[]
  auditLogs    AuditLog[]
  shifts       Shift[]
  swapRequests SwapRequest[]

  @@map("businesses")
}

model Membership {
  id          String           @id @default(cuid())
  businessId  String
  userId      String
  role        MembershipRole   @default(STAFF)
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments     ShiftAssignment[]
  swapRequests    SwapRequest[]     @relation("RequesterMembership")
  receivedSwaps   SwapRequest[]     @relation("TargetMembership")
  reviewedSwaps   SwapRequest[]     @relation("ReviewerMembership")

  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([userId, status])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(cuid())
  businessId  String
  email       String
  role        MembershipRole   @default(STAFF)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@index([businessId, email])
  @@index([token, status])
  @@map("invitations")
}

model Department {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shifts     Shift[]

  @@unique([businessId, name])
  @@map("departments")
}

model Location {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shifts     Shift[]

  @@unique([businessId, name])
  @@map("locations")
}

model Shift {
  id           String            @id @default(cuid())
  businessId   String
  departmentId String?
  locationId   String?
  title        String?
  startTime    DateTime
  endTime      DateTime
  breakMinutes Int               @default(0)
  notes        String?
  status       ShiftStatus       @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments  ShiftAssignment[]

  @@index([businessId, startTime, endTime])
  @@index([businessId, status])
  @@map("shifts")
}

model ShiftAssignment {
  id           String        @id @default(cuid())
  shiftId      String
  membershipId String
  status       String        @default("ASSIGNED")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  shift        Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  swapRequests SwapRequest[]

  @@unique([shiftId, membershipId])
  @@index([membershipId])
  @@map("shift_assignments")
}

model SwapRequest {
  id                    String          @id @default(cuid())
  businessId            String
  shiftAssignmentId     String
  requesterMembershipId String
  targetMembershipId    String?
  status                SwapStatus      @default(PENDING)
  reason                String?
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  business              Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shiftAssignment       ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)
  requesterMembership   Membership      @relation("RequesterMembership", fields: [requesterMembershipId], references: [id], onDelete: Cascade)
  targetMembership      Membership?     @relation("TargetMembership", fields: [targetMembershipId], references: [id], onDelete: SetNull)
  reviewedBy            Membership?     @relation("ReviewerMembership", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([requesterMembershipId])
  @@index([shiftAssignmentId, status])
  @@map("swap_requests")
}

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc), id(sort: Desc)], name: "idx_audit_logs_cursor")
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  familyId  String    // Groups rotated tokens to detect replay/theft attacks
  isRevoked Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("magic_link_tokens")
}
