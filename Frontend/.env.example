# ==============================================================================
# ROTA FRONTEND CONFIGURATION (.env.example)
# ==============================================================================
# HOW TO CHANGE YOUR LAN IP:
# 1. Open PowerShell and run: `ipconfig` or `Get-NetIPAddress -AddressFamily IPv4`
# 2. Look for your active Wi-Fi or Ethernet IPv4 address (e.g. 192.168.100.7)
# 3. Replace the IP in EXPO_PUBLIC_API_URL below with your current computer's LAN IP.
# 4. Do NOT use "localhost" or "127.0.0.1" because physical phones or Expo Go cannot
#    reach your host machine via localhost.
# ==============================================================================

EXPO_PUBLIC_API_URL=http://192.168.100.7:5000

# Flutterwave Public Key (Safe for client, used for Flutterwave inline checkout if needed)
EXPO_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-your-flutterwave-public-key-X
